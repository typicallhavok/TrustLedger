# Fabric Network Configuration
FABRIC_NETWORK_DIR=~/fabric-samples/test-network
FABRIC_ORG=Org1
FABRIC_MSPID=Org1MSP
CHANNEL_NAME=mychannel
CONTRACT_NAME=evidencecc

# Peer Configuration
FABRIC_PEER_HOSTS=localhost:7051,localhost:9051
FABRIC_PEER_NAMES=peer0.org1.example.com,peer1.org1.example.com

# CA Configuration
FABRIC_CA_HOST=localhost:7054
FABRIC_CA_NAME=ca.org1.example.com
FABRIC_CA_ORG_NAME=ca-org1

# User Configuration
FABRIC_USER=appUser
FABRIC_USER_PASSWD=appUserpw

# Output Configuration
WALLET_PATH=wallet
CONNECTION_JSON_PATH=connection-org1.json